DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ── GyanSetu AI (server-side only, NEVER expose to the browser) ──────────
# NVIDIA Nemotron 3 Ultra via OpenRouter — up to three keys for resilience
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_API_KEY_2=sk-or-v1-...
OPENROUTER_API_KEY_3=sk-or-v1-...

# OpenRouter model slug
NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# NVIDIA NIM direct (same Nemotron model) — up to two keys for resilience
NVIDIA_API_KEY=nvapi-...
NVIDIA_API_KEY_2=nvapi-...
